# zMail 环境变量示例
#
# - systemd 部署：复制到 /etc/zmail/zmail.env 并 chmod 600，由 unit 的 EnvironmentFile= 注入；
# - 本地开发：复制为项目根目录的 .env，程序启动时会自动加载（进程环境变量优先）。
#
# 生成密钥（各自执行一次，务必妥善保存；更换 CREDENTIALS_KEY 会导致已存密码无法解密）：
#   /opt/zmail/zmail -genkey 或 go run ./cmd/zmail -genkey
#
# 配置自检：go run ./cmd/zmail -check-config

LISTEN_ADDR=127.0.0.1:7080
PUBLIC_URL=https://mail.example.com

DB_PATH=/var/lib/zmail/zmail.db
RAW_DIR=/var/lib/zmail/raw

# 单用户访问密码（请使用强密码）
APP_PASSWORD=change-me
# base64 编码的 32 字节密钥
SESSION_KEY=
CREDENTIALS_KEY=

# 拉取与同步
MAX_FETCH_CONCURRENCY=4
IDLE_REFRESH_SECONDS=1500
BACKFILL_ENABLED=true
# 自建内网 IMAP 时才设为 true
ALLOW_PRIVATE_IMAP=false

# 受信代理网段（只有这些来源的 X-Forwarded-* 才生效）
TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128

LOG_LEVEL=info
